# Hopi Hari BI platform — environment template.
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`,
# `.project-config.json` or any file containing the values below.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (MySQL / TiDB) ---------------------------------------------------
# Required in production. Use a dedicated least-privilege user.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?ssl={\"rejectUnauthorized\":true}" # check-secrets: allow (placeholder)
# Shared mysql2 pool size for the raw-SQL modules (default 8).
# MYSQL_POOL_SIZE=8

# --- Session cookie (OAuth login flow) -----------------------------------------
# Required in production, at least 16 chars (32+ recommended): `openssl rand -base64 48`
JWT_SECRET=
# lax (default, CSRF-safe) | strict | none (only for embedded iframe deployments)
# SESSION_COOKIE_SAME_SITE=lax

# --- Manus OAuth / Forge platform services -------------------------------------
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Supabase ------------------------------------------------------------------
# Data project (read by the server for BI snapshots). Anon/publishable keys are
# public by design; Row Level Security decides what they can read.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Auth project (user sign-in). The server verifies the browser's access token here.
AUTH_SUPABASE_URL=
AUTH_SUPABASE_ANON_KEY=
# Browser-side equivalents (bundled into the client; public values only!)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_AUTH_SUPABASE_URL=
VITE_AUTH_SUPABASE_PUBLISHABLE_KEY=

# --- Google Drive campaign sync (service account) ------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# Keep the literal \n sequences; the server converts them to newlines.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- X (Twitter) listening -----------------------------------------------------
X_BEARER_TOKEN=
# X_SEARCH_QUERY=

# --- Security layer (see SECURITY.md) ------------------------------------------
# Reverse-proxy hops to trust for client IPs (default: 1 in production, false otherwise).
# TRUST_PROXY=1
# Extra browser origins allowed to call the API with credentials (comma separated).
# ALLOWED_ORIGINS=https://bi.example.com
# Content-Security-Policy: enforce (default in production) | report-only | off
# CSP_MODE=enforce
# Extra connect-src hosts for the CSP (comma separated), e.g. an analytics endpoint.
# CSP_CONNECT_SRC=
# Who may embed the app in an iframe (CSP frame-ancestors). Default: 'self'
# ALLOWED_FRAME_ANCESTORS='self'
# Default request body limit (large uploads have route-specific limits).
# BODY_LIMIT=1mb
# Storage keys under these prefixes are served without a session (default: public/).
# PUBLIC_STORAGE_PREFIXES=public/
# Emergency switch — never leave enabled in production.
# RATE_LIMIT_DISABLED=false

# --- Never put secrets in VITE_* variables: they are inlined into the public bundle.
